# Copy to .env and adjust. .env is gitignored and must never be committed.
# Every variable is prefixed DEVPILOT_ and parsed by core/config.py.

DEVPILOT_ENVIRONMENT=local
DEVPILOT_DEBUG=true
DEVPILOT_LOG_LEVEL=DEBUG

# Must use the postgresql+asyncpg scheme; the app uses SQLAlchemy's async engine.
DEVPILOT_DATABASE_URL=postgresql+asyncpg://devpilot:devpilot@localhost:5432/devpilot
DEVPILOT_DB_POOL_SIZE=5
DEVPILOT_DB_MAX_OVERFLOW=10
DEVPILOT_DB_POOL_TIMEOUT_SECONDS=5

# JWT signing. Required -- the app refuses to start without it. This is an
# example value generated for local use only; generate your own for any shared
# or deployed environment with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never commit a real secret. Minimum length is 32 characters, enforced at boot.
DEVPILOT_JWT_SECRET=tpErDMO_LBgSvm6uN8g_x0ARY1q8ojkqbs7jlTGO5hK39hHvIA68QXpQ2hknqgj1
DEVPILOT_JWT_ACCESS_TTL_MINUTES=15

# --- Indexing limits (M3). Each is enforced independently. ---
DEVPILOT_INDEX_MAX_REPO_BYTES=209715200      # 200 MB
DEVPILOT_INDEX_MAX_FILES=5000
DEVPILOT_INDEX_MAX_FILE_BYTES=1048576         # 1 MB
DEVPILOT_INDEX_CLONE_TIMEOUT_SECONDS=300

# --- Worker loop (M3) ---
DEVPILOT_WORKER_POLL_INTERVAL_SECONDS=2
DEVPILOT_WORKER_HEARTBEAT_INTERVAL_SECONDS=10
DEVPILOT_WORKER_LEASE_TIMEOUT_SECONDS=60
DEVPILOT_JOB_MAX_ATTEMPTS=3

# --- Embeddings (M4) ---
# Provider: 'sentence_transformer' (real, lazy-loaded) or 'fake' (deterministic,
# no model/network -- used by tests and CI). The real model downloads once into
# HF_HOME on first use.
DEVPILOT_EMBEDDING_PROVIDER=sentence_transformer
DEVPILOT_EMBEDDING_MODEL=jinaai/jina-embeddings-v2-base-code
# EMBEDDING_DIM is NOT a free knob: migration 0004 declares the vector column as
# vector(768), so 768 is a schema invariant for this version. Changing it
# requires a new migration that alters the column and rebuilds the HNSW index;
# the app refuses to start if this value disagrees with the schema dimension.
DEVPILOT_EMBEDDING_DIM=768
DEVPILOT_EMBEDDING_BATCH_SIZE=32

# --- Chunking (M4) --- overlap must be >= 0 and strictly less than the window.
DEVPILOT_CHUNK_WINDOW_LINES=40
DEVPILOT_CHUNK_OVERLAP_LINES=10

# --- Semantic search (M4) ---
DEVPILOT_SEARCH_DEFAULT_TOP_K=10
DEVPILOT_SEARCH_MAX_TOP_K=50

# Hugging Face cache location. In Docker this is a named volume so the model is
# downloaded once and reused across restarts by both the API and the worker.
HF_HOME=/models

DEVPILOT_CORS_ORIGINS=["http://localhost:5173"]
