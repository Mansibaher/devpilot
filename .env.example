# Copy to .env and adjust. .env is gitignored and must never be committed.
# Every variable is prefixed DEVPILOT_ and parsed by core/config.py.

DEVPILOT_ENVIRONMENT=local
DEVPILOT_DEBUG=true
DEVPILOT_LOG_LEVEL=DEBUG

# Must use the postgresql+asyncpg scheme; the app uses SQLAlchemy's async engine.
DEVPILOT_DATABASE_URL=postgresql+asyncpg://devpilot:devpilot@localhost:5432/devpilot
DEVPILOT_DB_POOL_SIZE=5
DEVPILOT_DB_MAX_OVERFLOW=10
DEVPILOT_DB_POOL_TIMEOUT_SECONDS=5

DEVPILOT_CORS_ORIGINS=["http://localhost:5173"]
